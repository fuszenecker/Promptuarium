<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\Promptuarium.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>pedit</AssemblyName>
    <RootNamespace>PEdit</RootNamespace>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <AnalysisLevel>preview</AnalysisLevel>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <!-- CA1303: the messages of a command line tool are not localized;
         CA1849: the console output is written synchronously, line by line -->
    <NoWarn>$(NoWarn);CA1303;CA1849</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Promptuarium.Tests" />
  </ItemGroup>

</Project>
