<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PStudio.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, DejaVu Sans Mono, Liberation Mono, monospace</FontFamily>
      <!-- The raw tree is set off from the serializer view by its background; the groups of the two views -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="RawTreeBackground" Color="#101010" />
          <SolidColorBrush x:Key="GroupBackground" Color="#1C1C1C" />
          <SolidColorBrush x:Key="SyntaxKey" Color="#9CDCFE" />
          <SolidColorBrush x:Key="SyntaxString" Color="#CE9178" />
          <SolidColorBrush x:Key="SyntaxNumber" Color="#B5CEA8" />
          <SolidColorBrush x:Key="SyntaxKeyword" Color="#569CD6" />
          <SolidColorBrush x:Key="SyntaxTag" Color="#C586C0" />
          <SolidColorBrush x:Key="SyntaxComment" Color="#6A9955" />
          <SolidColorBrush x:Key="SyntaxPunctuation" Color="#808080" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="RawTreeBackground" Color="#EDEDED" />
          <SolidColorBrush x:Key="GroupBackground" Color="#F9F9F9" />
          <SolidColorBrush x:Key="SyntaxKey" Color="#0451A5" />
          <SolidColorBrush x:Key="SyntaxString" Color="#A31515" />
          <SolidColorBrush x:Key="SyntaxNumber" Color="#098658" />
          <SolidColorBrush x:Key="SyntaxKeyword" Color="#0000FF" />
          <SolidColorBrush x:Key="SyntaxTag" Color="#AF00DB" />
          <SolidColorBrush x:Key="SyntaxComment" Color="#008000" />
          <SolidColorBrush x:Key="SyntaxPunctuation" Color="#6E6E6E" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
