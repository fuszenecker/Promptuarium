<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PStudio.ViewModels"
        xmlns:v="using:PStudio.Views"
        x:Class="PStudio.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="/Assets/pstudio.ico"
        Width="1440" Height="860"
        MinWidth="640" MinHeight="480">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
    <KeyBinding Gesture="F6" Command="{Binding ToggleChunkPanelCommand}" />
    <KeyBinding Gesture="F7" Command="{Binding ToggleSerializerPanelCommand}" />
  </Window.KeyBindings>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New" Command="{Binding NewCommand}" InputGesture="Ctrl+N" />
        <MenuItem Header="_Open…" Command="{Binding OpenCommand}" InputGesture="Ctrl+O" />
        <MenuItem Header="Open _Recent" ItemsSource="{Binding RecentFiles}" IsEnabled="{Binding HasRecentFiles}">
          <MenuItem.Styles>
            <Style Selector="MenuItem > MenuItem" x:DataType="vm:MenuEntry">
              <Setter Property="Header" Value="{Binding Header}" />
              <Setter Property="Command" Value="{Binding Command}" />
              <Setter Property="CommandParameter" Value="{Binding Parameter}" />
            </Style>
          </MenuItem.Styles>
        </MenuItem>
        <Separator />
        <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGesture="Ctrl+S" />
        <MenuItem Header="Save _As…" Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S" />
        <Separator />
        <MenuItem Header="_Close" Command="{Binding CloseCommand}" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="Cu_t" Command="{Binding CutCommand}" InputGesture="Ctrl+X" />
        <MenuItem Header="_Copy" Command="{Binding CopyCommand}" InputGesture="Ctrl+C" />
        <MenuItem Header="_Paste as Child" Command="{Binding PasteAsChildCommand}" InputGesture="Ctrl+V" />
        <MenuItem Header="Paste _After" Command="{Binding PasteAfterCommand}" InputGesture="Ctrl+Shift+V" />
      </MenuItem>
      <MenuItem Header="_Node">
        <MenuItem Header="Add _Child" Command="{Binding AddChildCommand}" InputGesture="Insert" />
        <MenuItem Header="Add _Sibling" Command="{Binding AddSiblingCommand}" InputGesture="Shift+Insert" />
        <MenuItem Header="_Delete" Command="{Binding DeleteCommand}" InputGesture="Delete" />
        <Separator />
        <MenuItem Header="Move _Up" Command="{Binding MoveUpCommand}" InputGesture="Shift+Up" />
        <MenuItem Header="Move Do_wn" Command="{Binding MoveDownCommand}" InputGesture="Shift+Down" />
        <MenuItem Header="_Indent" Command="{Binding IndentCommand}" InputGesture="Shift+Right" />
        <MenuItem Header="_Outdent" Command="{Binding OutdentCommand}" InputGesture="Shift+Left" />
        <Separator />
        <MenuItem Header="Open Data as _Nested Tree…" Command="{Binding OpenNestedCommand}" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Chunks" ToggleType="CheckBox" IsChecked="{Binding IsChunkPanelVisible, Mode=OneWay}" Command="{Binding ToggleChunkPanelCommand}" InputGesture="F6" />
        <MenuItem Header="_Serializer" ToggleType="CheckBox" IsChecked="{Binding IsSerializerPanelVisible, Mode=OneWay}" Command="{Binding ToggleSerializerPanelCommand}" InputGesture="F7"
                  ToolTip.Tip="The tree as the values of the serializer format; shown when the tree is serializable" />
        <Separator />
        <MenuItem Header="_Reset Types" Command="{Binding ResetTypesCommand}" ToolTip.Tip="Forget the forms chosen for the metadata and the data of the nodes of this tree" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_About Promptuarium Studio…" Command="{Binding AboutCommand}" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Bottom" Padding="8,4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <TextBlock Text="{Binding StatusText}" Classes.error="{Binding IsStatusError}" TextTrimming="CharacterEllipsis" />
    </Border>

    <Grid x:Name="MainGrid" RowDefinitions="*,Auto,220">
      <Grid x:Name="UpperGrid" Grid.Row="0" ColumnDefinitions="2*,Auto,3*,Auto,3*">
        <TreeView x:Name="Tree"
                  Grid.Column="0"
                  Margin="6"
                  ItemsSource="{Binding Roots}"
                  SelectedItem="{Binding SelectedNode}">
          <TreeView.KeyBindings>
            <KeyBinding Gesture="Insert" Command="{Binding AddChildCommand}" />
            <KeyBinding Gesture="Shift+Insert" Command="{Binding AddSiblingCommand}" />
            <KeyBinding Gesture="Delete" Command="{Binding DeleteCommand}" />
            <KeyBinding Gesture="Shift+Up" Command="{Binding MoveUpCommand}" />
            <KeyBinding Gesture="Shift+Down" Command="{Binding MoveDownCommand}" />
            <KeyBinding Gesture="Shift+Right" Command="{Binding IndentCommand}" />
            <KeyBinding Gesture="Shift+Left" Command="{Binding OutdentCommand}" />
            <KeyBinding Gesture="Ctrl+X" Command="{Binding CutCommand}" />
            <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyCommand}" />
            <KeyBinding Gesture="Ctrl+V" Command="{Binding PasteAsChildCommand}" />
            <KeyBinding Gesture="Ctrl+Shift+V" Command="{Binding PasteAfterCommand}" />
          </TreeView.KeyBindings>
          <TreeView.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Add Child" Command="{Binding AddChildCommand}" InputGesture="Insert" />
              <MenuItem Header="Add Sibling" Command="{Binding AddSiblingCommand}" InputGesture="Shift+Insert" />
              <Separator />
              <MenuItem Header="Cut" Command="{Binding CutCommand}" InputGesture="Ctrl+X" />
              <MenuItem Header="Copy" Command="{Binding CopyCommand}" InputGesture="Ctrl+C" />
              <MenuItem Header="Paste as Child" Command="{Binding PasteAsChildCommand}" InputGesture="Ctrl+V" />
              <MenuItem Header="Paste After" Command="{Binding PasteAfterCommand}" InputGesture="Ctrl+Shift+V" />
              <Separator />
              <MenuItem Header="Move Up" Command="{Binding MoveUpCommand}" InputGesture="Shift+Up" />
              <MenuItem Header="Move Down" Command="{Binding MoveDownCommand}" InputGesture="Shift+Down" />
              <MenuItem Header="Indent" Command="{Binding IndentCommand}" InputGesture="Shift+Right" />
              <MenuItem Header="Outdent" Command="{Binding OutdentCommand}" InputGesture="Shift+Left" />
              <Separator />
              <MenuItem Header="Open Data as Nested Tree…" Command="{Binding OpenNestedCommand}" />
              <Separator />
              <MenuItem Header="Delete" Command="{Binding DeleteCommand}" InputGesture="Delete" />
            </ContextMenu>
          </TreeView.ContextMenu>
          <TreeView.Styles>
            <Style Selector="TreeViewItem" x:DataType="vm:NodeViewModel">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            </Style>
          </TreeView.Styles>
          <TreeView.ItemTemplate>
            <TreeDataTemplate x:DataType="vm:NodeViewModel" ItemsSource="{Binding Children}">
              <Border Classes="nodeHeader" Padding="2,1" BorderThickness="0,2" BorderBrush="Transparent" CornerRadius="3">
                <TextBlock Text="{Binding Header}" FontFamily="{StaticResource MonoFont}" />
              </Border>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>

        <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns" IsVisible="{Binding IsSerializerPanelShown}" />

        <DockPanel x:Name="SerializerPanel" Grid.Column="2" Margin="6" IsVisible="{Binding IsSerializerPanelShown}">
          <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,4">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="Serializer" FontWeight="SemiBold" VerticalAlignment="Center" />
              <TextBlock Classes="dim" Text="{Binding SerializerSummary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding SerializerSummary}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <Button Classes="tool" Content="Add" Command="{Binding SerializerAddCommand}" ToolTip.Tip="Add a member or an element into the selected object or array, or after the selected value (Insert)" />
              <Button Classes="tool" Content="Add After" Command="{Binding SerializerAddAfterCommand}" ToolTip.Tip="Add a member or an element after the selected value (Shift+Insert)" />
              <Button Classes="tool" Content="Delete" Command="{Binding SerializerDeleteCommand}" ToolTip.Tip="Delete the selected value (Delete)" />
              <Button Classes="tool" Content="Up" Command="{Binding SerializerMoveUpCommand}" ToolTip.Tip="Move the selected value up (Shift+Up)" />
              <Button Classes="tool" Content="Down" Command="{Binding SerializerMoveDownCommand}" ToolTip.Tip="Move the selected value down (Shift+Down)" />
            </StackPanel>
          </StackPanel>

          <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*" Margin="0,6,0,0" IsVisible="{Binding SelectedSerializerNode, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Grid.Column="0" Text="Comment" VerticalAlignment="Top" Margin="0,6,8,0" />
            <TextBox x:Name="SerializerComment" Grid.Column="1" Tag="comment"
                     DataContext="{Binding SelectedSerializerNode}"
                     x:DataType="vm:SerializerNodeViewModel"
                     Text="{Binding CommentText}"
                     AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="90"
                     PlaceholderText="No comment"
                     ToolTip.Tip="The comment of the selected value (COMMENT nodes); Ctrl+Enter or leaving the box applies it, Escape reverts it" />
          </Grid>

          <TreeView x:Name="SerializerTree"
                    ItemsSource="{Binding SerializerRoots}"
                    SelectedItem="{Binding SelectedSerializerNode}">
            <TreeView.KeyBindings>
              <KeyBinding Gesture="Insert" Command="{Binding SerializerAddCommand}" />
              <KeyBinding Gesture="Shift+Insert" Command="{Binding SerializerAddAfterCommand}" />
              <KeyBinding Gesture="Delete" Command="{Binding SerializerDeleteCommand}" />
              <KeyBinding Gesture="Shift+Up" Command="{Binding SerializerMoveUpCommand}" />
              <KeyBinding Gesture="Shift+Down" Command="{Binding SerializerMoveDownCommand}" />
            </TreeView.KeyBindings>
            <TreeView.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Add" Command="{Binding SerializerAddCommand}" InputGesture="Insert" />
                <MenuItem Header="Add After" Command="{Binding SerializerAddAfterCommand}" InputGesture="Shift+Insert" />
                <Separator />
                <MenuItem Header="Move Up" Command="{Binding SerializerMoveUpCommand}" InputGesture="Shift+Up" />
                <MenuItem Header="Move Down" Command="{Binding SerializerMoveDownCommand}" InputGesture="Shift+Down" />
                <Separator />
                <MenuItem Header="Open Container as Nested Tree…" Command="{Binding SerializerOpenContainerCommand}" />
                <Separator />
                <MenuItem Header="Delete" Command="{Binding SerializerDeleteCommand}" InputGesture="Delete" />
              </ContextMenu>
            </TreeView.ContextMenu>
            <TreeView.Styles>
              <Style Selector="TreeViewItem" x:DataType="vm:SerializerNodeViewModel">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              </Style>
            </TreeView.Styles>
            <TreeView.ItemTemplate>
              <TreeDataTemplate x:DataType="vm:SerializerNodeViewModel" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1">
                  <TextBlock Classes="label" Text="{Binding Label}" IsVisible="{Binding HasLabel}" VerticalAlignment="Center" />
                  <TextBox Classes="inline name" Tag="name" Text="{Binding NameText}" IsVisible="{Binding IsMember}"
                           MinWidth="110" ToolTip.Tip="The name of the member; Enter applies, Escape reverts" />
                  <ComboBox Classes="type" ItemsSource="{x:Static vm:SerializerNodeViewModel.TypeOptions}" SelectedItem="{Binding SelectedType}"
                            IsVisible="{Binding HasType}" Width="140" ToolTip.Tip="The type; another one converts the value" />
                  <CheckBox IsChecked="{Binding BoolValue}" IsVisible="{Binding IsBool}" VerticalAlignment="Center" />
                  <TextBox Classes="inline value" Tag="value" Text="{Binding ValueText}" IsVisible="{Binding IsTextValue}"
                           Classes.invalid="{Binding HasValueError}" MinWidth="160" MaxWidth="480" ToolTip.Tip="{Binding ValueTip}" />
                  <TextBlock Classes="dim" Text="{Binding Summary}" IsVisible="{Binding HasSummary}" VerticalAlignment="Center" />
                  <TextBlock Classes="comment" Text="{Binding CommentPreview}" IsVisible="{Binding HasComment}" VerticalAlignment="Center" MaxWidth="320" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>
        </DockPanel>

        <GridSplitter Grid.Column="3" Width="4" ResizeDirection="Columns" />

        <Grid Grid.Column="4" RowDefinitions="Auto,*,Auto,*" Margin="6,6,8,6">
          <Border Grid.Row="0" Classes="card" Margin="0,0,0,12">
            <StackPanel Spacing="2">
              <TextBlock Classes="path" Text="{Binding NodePath}" />
              <TextBlock Text="{Binding NodeSummary}" />
              <TextBlock Classes="dim" Text="{Binding NodeEncoding}" IsVisible="{Binding IsChunkPanelVisible}" />
            </StackPanel>
          </Border>
          <v:ContentEditorView Grid.Row="1" DataContext="{Binding MetaData}" />
          <GridSplitter Grid.Row="2" Height="4" ResizeDirection="Rows" Margin="0,6" />
          <v:ContentEditorView Grid.Row="3" DataContext="{Binding Data}" />
        </Grid>
      </Grid>

      <GridSplitter x:Name="ChunkSplitter" Grid.Row="1" Height="4" ResizeDirection="Rows" IsVisible="{Binding IsChunkPanelVisible}" />

      <DockPanel Grid.Row="2" Margin="6,4,8,6" IsVisible="{Binding IsChunkPanelVisible}">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,4">
          <TextBlock Text="Chunks" FontWeight="SemiBold" />
          <TextBlock Classes="dim" Text="{Binding ChunkSummary}" />
          <TextBlock Classes="dim" Text="the chunks of the selected node are highlighted; a click on a chunk selects its node" />
        </StackPanel>
        <DataGrid x:Name="ChunkGrid"
                  ItemsSource="{Binding Chunks}"
                  SelectedItem="{Binding SelectedChunk}"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True"
                  CanUserSortColumns="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Vertical"
                  RowHeight="22"
                  FontFamily="{StaticResource MonoFont}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Offset" Width="Auto" MinWidth="40" x:DataType="vm:ChunkRowViewModel" Binding="{Binding Row.Offset}" />
            <DataGridTextColumn Header="Ctl" Width="Auto" MinWidth="40" x:DataType="vm:ChunkRowViewModel" Binding="{Binding Row.Control}" />
            <DataGridTextColumn Header="Dir" Width="Auto" MinWidth="40" x:DataType="vm:ChunkRowViewModel" Binding="{Binding Row.Direction}" />
            <DataGridTextColumn Header="Type" Width="Auto" MinWidth="40" x:DataType="vm:ChunkRowViewModel" Binding="{Binding Row.ContentType}" />
            <DataGridTextColumn Header="Length" Width="Auto" MinWidth="40" x:DataType="vm:ChunkRowViewModel" Binding="{Binding Row.Length}" />
            <DataGridTextColumn Header="Kind" Width="Auto" MinWidth="40" x:DataType="vm:ChunkRowViewModel" Binding="{Binding Row.Kind}" />
            <DataGridTextColumn Header="Depth" Width="Auto" MinWidth="40" x:DataType="vm:ChunkRowViewModel" Binding="{Binding Row.Depth}" />
            <DataGridTextColumn Header="Payload" Width="*" x:DataType="vm:ChunkRowViewModel" Binding="{Binding Row.Payload}" />
          </DataGrid.Columns>
          <DataGrid.Styles>
            <Style Selector="DataGridRow" x:DataType="vm:ChunkRowViewModel">
              <Setter Property="Classes.ofSelectedNode" Value="{Binding IsOfSelectedNode}" />
            </Style>
          </DataGrid.Styles>
        </DataGrid>
      </DockPanel>
    </Grid>
  </DockPanel>

  <Window.Styles>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="OrangeRed" />
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentLowBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
      <Setter Property="BorderThickness" Value="4,0,0,0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="TextBlock.path">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBox.inline">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBox.name">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBox.invalid">
      <Setter Property="BorderBrush" Value="OrangeRed" />
    </Style>
    <Style Selector="TextBox.invalid:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="OrangeRed" />
    </Style>
    <Style Selector="ComboBox.type">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.comment">
      <Setter Property="FontStyle" Value="Italic" />
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Button.tool">
      <Setter Property="Padding" Value="10,3" />
    </Style>
    <Style Selector="DataGridRow.ofSelectedNode">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentLowBrush}" />
    </Style>
    <Style Selector="Border.nodeHeader.dropInside">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentMediumBrush}" />
    </Style>
    <Style Selector="Border.nodeHeader.dropBefore">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
      <Setter Property="BorderThickness" Value="0,2,0,0" />
    </Style>
    <Style Selector="Border.nodeHeader.dropAfter">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>
  </Window.Styles>
</Window>
