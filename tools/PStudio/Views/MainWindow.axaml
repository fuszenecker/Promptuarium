<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PStudio.ViewModels"
        xmlns:v="using:PStudio.Views"
        x:Class="PStudio.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1200" Height="800"
        MinWidth="640" MinHeight="480">

  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+N" Command="{Binding NewCommand}" />
    <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenCommand}" />
    <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}" />
    <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
    <KeyBinding Gesture="F6" Command="{Binding ToggleChunkPanelCommand}" />
  </Window.KeyBindings>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New" Command="{Binding NewCommand}" InputGesture="Ctrl+N" />
        <MenuItem Header="_Open…" Command="{Binding OpenCommand}" InputGesture="Ctrl+O" />
        <MenuItem Header="Open _Recent" ItemsSource="{Binding RecentFiles}" IsEnabled="{Binding HasRecentFiles}">
          <MenuItem.Styles>
            <Style Selector="MenuItem > MenuItem" x:DataType="vm:MenuEntry">
              <Setter Property="Header" Value="{Binding Header}" />
              <Setter Property="Command" Value="{Binding Command}" />
              <Setter Property="CommandParameter" Value="{Binding Parameter}" />
            </Style>
          </MenuItem.Styles>
        </MenuItem>
        <Separator />
        <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGesture="Ctrl+S" />
        <MenuItem Header="Save _As…" Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S" />
        <Separator />
        <MenuItem Header="_Close" Command="{Binding CloseCommand}" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="Cu_t" Command="{Binding CutCommand}" InputGesture="Ctrl+X" />
        <MenuItem Header="_Copy" Command="{Binding CopyCommand}" InputGesture="Ctrl+C" />
        <MenuItem Header="_Paste as Child" Command="{Binding PasteAsChildCommand}" InputGesture="Ctrl+V" />
        <MenuItem Header="Paste _After" Command="{Binding PasteAfterCommand}" InputGesture="Ctrl+Shift+V" />
      </MenuItem>
      <MenuItem Header="_Node">
        <MenuItem Header="Add _Child" Command="{Binding AddChildCommand}" InputGesture="Insert" />
        <MenuItem Header="Add _Sibling" Command="{Binding AddSiblingCommand}" InputGesture="Ctrl+Insert" />
        <MenuItem Header="_Delete" Command="{Binding DeleteCommand}" InputGesture="Delete" />
        <Separator />
        <MenuItem Header="Move _Up" Command="{Binding MoveUpCommand}" InputGesture="Alt+Up" />
        <MenuItem Header="Move Do_wn" Command="{Binding MoveDownCommand}" InputGesture="Alt+Down" />
        <MenuItem Header="_Indent" Command="{Binding IndentCommand}" InputGesture="Alt+Right" />
        <MenuItem Header="_Outdent" Command="{Binding OutdentCommand}" InputGesture="Alt+Left" />
        <Separator />
        <MenuItem Header="Open Data as _Nested Tree…" Command="{Binding OpenNestedCommand}" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Chunks" ToggleType="CheckBox" IsChecked="{Binding IsChunkPanelVisible, Mode=OneWay}" Command="{Binding ToggleChunkPanelCommand}" InputGesture="F6" />
        <Separator />
        <MenuItem Header="_Reset Types" Command="{Binding ResetTypesCommand}" ToolTip.Tip="Forget the forms chosen for the data and the metadata of the nodes of this tree" />
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Bottom" Padding="8,4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
      <TextBlock Text="{Binding StatusText}" Classes.error="{Binding IsStatusError}" TextTrimming="CharacterEllipsis" />
    </Border>

    <Grid x:Name="MainGrid" RowDefinitions="*,Auto,220">
      <Grid Grid.Row="0" ColumnDefinitions="2*,Auto,3*">
        <TreeView x:Name="Tree"
                  Grid.Column="0"
                  Margin="6"
                  ItemsSource="{Binding Roots}"
                  SelectedItem="{Binding SelectedNode}">
          <TreeView.KeyBindings>
            <KeyBinding Gesture="Insert" Command="{Binding AddChildCommand}" />
            <KeyBinding Gesture="Ctrl+Insert" Command="{Binding AddSiblingCommand}" />
            <KeyBinding Gesture="Delete" Command="{Binding DeleteCommand}" />
            <KeyBinding Gesture="Alt+Up" Command="{Binding MoveUpCommand}" />
            <KeyBinding Gesture="Alt+Down" Command="{Binding MoveDownCommand}" />
            <KeyBinding Gesture="Alt+Right" Command="{Binding IndentCommand}" />
            <KeyBinding Gesture="Alt+Left" Command="{Binding OutdentCommand}" />
            <KeyBinding Gesture="Ctrl+X" Command="{Binding CutCommand}" />
            <KeyBinding Gesture="Ctrl+C" Command="{Binding CopyCommand}" />
            <KeyBinding Gesture="Ctrl+V" Command="{Binding PasteAsChildCommand}" />
            <KeyBinding Gesture="Ctrl+Shift+V" Command="{Binding PasteAfterCommand}" />
          </TreeView.KeyBindings>
          <TreeView.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Add Child" Command="{Binding AddChildCommand}" InputGesture="Insert" />
              <MenuItem Header="Add Sibling" Command="{Binding AddSiblingCommand}" InputGesture="Ctrl+Insert" />
              <Separator />
              <MenuItem Header="Cut" Command="{Binding CutCommand}" InputGesture="Ctrl+X" />
              <MenuItem Header="Copy" Command="{Binding CopyCommand}" InputGesture="Ctrl+C" />
              <MenuItem Header="Paste as Child" Command="{Binding PasteAsChildCommand}" InputGesture="Ctrl+V" />
              <MenuItem Header="Paste After" Command="{Binding PasteAfterCommand}" InputGesture="Ctrl+Shift+V" />
              <Separator />
              <MenuItem Header="Move Up" Command="{Binding MoveUpCommand}" InputGesture="Alt+Up" />
              <MenuItem Header="Move Down" Command="{Binding MoveDownCommand}" InputGesture="Alt+Down" />
              <MenuItem Header="Indent" Command="{Binding IndentCommand}" InputGesture="Alt+Right" />
              <MenuItem Header="Outdent" Command="{Binding OutdentCommand}" InputGesture="Alt+Left" />
              <Separator />
              <MenuItem Header="Open Data as Nested Tree…" Command="{Binding OpenNestedCommand}" />
              <Separator />
              <MenuItem Header="Delete" Command="{Binding DeleteCommand}" InputGesture="Delete" />
            </ContextMenu>
          </TreeView.ContextMenu>
          <TreeView.Styles>
            <Style Selector="TreeViewItem" x:DataType="vm:NodeViewModel">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            </Style>
          </TreeView.Styles>
          <TreeView.ItemTemplate>
            <TreeDataTemplate x:DataType="vm:NodeViewModel" ItemsSource="{Binding Children}">
              <Border Classes="nodeHeader" Padding="2,1" BorderThickness="0,2" BorderBrush="Transparent" CornerRadius="3">
                <TextBlock Text="{Binding Header}" FontFamily="{StaticResource MonoFont}" />
              </Border>
            </TreeDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>

        <GridSplitter Grid.Column="1" Width="4" ResizeDirection="Columns" />

        <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto,*" Margin="6,6,8,6">
          <Border Grid.Row="0" Classes="card" Margin="0,0,0,12">
            <StackPanel Spacing="2">
              <TextBlock Classes="path" Text="{Binding NodePath}" />
              <TextBlock Text="{Binding NodeSummary}" />
              <TextBlock Classes="dim" Text="{Binding NodeEncoding}" IsVisible="{Binding IsChunkPanelVisible}" />
            </StackPanel>
          </Border>
          <v:ContentEditorView Grid.Row="1" DataContext="{Binding Data}" />
          <GridSplitter Grid.Row="2" Height="4" ResizeDirection="Rows" Margin="0,6" />
          <v:ContentEditorView Grid.Row="3" DataContext="{Binding MetaData}" />
        </Grid>
      </Grid>

      <GridSplitter x:Name="ChunkSplitter" Grid.Row="1" Height="4" ResizeDirection="Rows" IsVisible="{Binding IsChunkPanelVisible}" />

      <DockPanel Grid.Row="2" Margin="6,4,8,6" IsVisible="{Binding IsChunkPanelVisible}">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,4">
          <TextBlock Text="Chunks" FontWeight="SemiBold" />
          <TextBlock Classes="dim" Text="{Binding ChunkSummary}" />
          <TextBlock Classes="dim" Text="the chunks of the selected node are highlighted; a click on a chunk selects its node" />
        </StackPanel>
        <DataGrid x:Name="ChunkGrid"
                  ItemsSource="{Binding Chunks}"
                  SelectedItem="{Binding SelectedChunk}"
                  IsReadOnly="True"
                  CanUserResizeColumns="True"
                  CanUserReorderColumns="True"
                  CanUserSortColumns="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Vertical"
                  RowHeight="22"
                  FontFamily="{StaticResource MonoFont}">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Offset" Width="Auto" MinWidth="40" x:DataType="vm:ChunkRowViewModel" Binding="{Binding Row.Offset}" />
            <DataGridTextColumn Header="Ctl" Width="Auto" MinWidth="40" x:DataType="vm:ChunkRowViewModel" Binding="{Binding Row.Control}" />
            <DataGridTextColumn Header="Dir" Width="Auto" MinWidth="40" x:DataType="vm:ChunkRowViewModel" Binding="{Binding Row.Direction}" />
            <DataGridTextColumn Header="Type" Width="Auto" MinWidth="40" x:DataType="vm:ChunkRowViewModel" Binding="{Binding Row.ContentType}" />
            <DataGridTextColumn Header="Length" Width="Auto" MinWidth="40" x:DataType="vm:ChunkRowViewModel" Binding="{Binding Row.Length}" />
            <DataGridTextColumn Header="Kind" Width="Auto" MinWidth="40" x:DataType="vm:ChunkRowViewModel" Binding="{Binding Row.Kind}" />
            <DataGridTextColumn Header="Depth" Width="Auto" MinWidth="40" x:DataType="vm:ChunkRowViewModel" Binding="{Binding Row.Depth}" />
            <DataGridTextColumn Header="Payload" Width="*" x:DataType="vm:ChunkRowViewModel" Binding="{Binding Row.Payload}" />
          </DataGrid.Columns>
          <DataGrid.Styles>
            <Style Selector="DataGridRow" x:DataType="vm:ChunkRowViewModel">
              <Setter Property="Classes.ofSelectedNode" Value="{Binding IsOfSelectedNode}" />
            </Style>
          </DataGrid.Styles>
        </DataGrid>
      </DockPanel>
    </Grid>
  </DockPanel>

  <Window.Styles>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="OrangeRed" />
    </Style>
    <Style Selector="TextBlock.dim">
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentLowBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
      <Setter Property="BorderThickness" Value="4,0,0,0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="TextBlock.path">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="DataGridRow.ofSelectedNode">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentLowBrush}" />
    </Style>
    <Style Selector="Border.nodeHeader.dropInside">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightListAccentMediumBrush}" />
    </Style>
    <Style Selector="Border.nodeHeader.dropBefore">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
      <Setter Property="BorderThickness" Value="0,2,0,0" />
    </Style>
    <Style Selector="Border.nodeHeader.dropAfter">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
    </Style>
  </Window.Styles>
</Window>
