<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\Promptuarium.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>pstudio</AssemblyName>
    <RootNamespace>PStudio</RootNamespace>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The texts are formatted with the invariant culture, so the self-contained build needs no ICU -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- The chunk view uses the decoder of pedit, which is independent of the library -->
    <Compile Include="..\PEdit\ChunkDecoder.cs" Link="Services\ChunkDecoder.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PStudio.Tests" />
  </ItemGroup>

</Project>
