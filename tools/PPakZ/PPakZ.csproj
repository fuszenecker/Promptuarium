<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\Promptuarium\Promptuarium.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ppakz</AssemblyName>
    <RootNamespace>PPakZ</RootNamespace>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- No culture-specific texts, so the self-contained build of the installers needs no ICU -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" Version="10.0.13" />
  </ItemGroup>

  <!-- The owners are read and set as in ppak -->
  <ItemGroup>
    <Compile Include="..\PPak\UnixOwner.cs" Link="UnixOwner.cs" />
  </ItemGroup>

</Project>
