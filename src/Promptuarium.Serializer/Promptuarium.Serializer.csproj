<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Promptuarium.Serializer</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The library implements the experimental PromptuariumType control, so it uses it freely -->
    <NoWarn>$(NoWarn);PRMTSER001</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Promptuarium.Serializer</PackageId>
    <Title>Promptuarium.Serializer</Title>
    <Description>A general serializer between .NET objects and Promptuarium trees in the PRMT:CFG1-LE layout: typed holders, byte[] as BLOB, no JSON in between; layering (Populate), records, attributes.</Description>
    <PackageTags>promptuarium serializer serialization configuration binary tree</PackageTags>
    <PackageReleaseNotes>Still experimental (opt-in PRMTSER000). New: version 2 of the layout (SERIALIZER_FORMAT.md). sbyte ... long, Int128, byte ... ulong, UInt128 and BigInteger are INT8 ... INT128, UINT8 ... UINT128 and BIGINT; Half, float and double are FLOAT16, FLOAT32 and FLOAT64 (NaN and the infinities allowed, a NaN written canonical); decimal is DECIMAL (its canonical text, the scale kept); Guid is UUID (RFC 9562 order); DateOnly, TimeOnly, TimeSpan are DATE, TIME, DURATION; DateTime is DATETIME (Unspecified) or TIMESTAMP (Utc, Local: the kind comes back); DateTimeOffset is TIMESTAMP. A file is signed with the lowest version that holds it: PRMT:GEN1-LE or PRMT:GEN2-LE (PRMT:CFG1-LE or PRMT:CFG2-LE); both are read, a file of version 1 with a type of version 2 is rejected, and the reading is lenient where nothing is lost (an integer into any integer type it fits, into a floating point type only if held exactly; the texts of version 1 into the dates and Guid). [PromptuariumType] (PRMTSER001) chooses another form for a property: e.g. Float64 on an int or a decimal, Utf8String on a Guid or a DateTime (the forms of version 1), Int64 on an int, BigInt on a long; a value the declared type does not hold exactly is rejected. Changed behaviour: an int, a Guid, a DateTime, ... is written as a type of version 2, so such a file is signed PRMT:GEN2-LE (PRMT:CFG2-LE) and is not read by 8.3.0 and earlier (declare the form of version 1 to keep it readable); a long beyond 2^53 or a decimal with more than 15 digits is rejected only when declared Float64; a NaN or an infinity is no longer rejected, it gives a file of version 2.</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Promptuarium/Promptuarium.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Promptuarium.Serializer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
