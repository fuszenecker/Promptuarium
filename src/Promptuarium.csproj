<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <Nullable>enable</Nullable>
    <AnalysisLevel>preview</AnalysisLevel>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Promptuarium</PackageId>
    <Title>Promptuarium</Title>
    <Version>7.1.0</Version>
    <Authors>Fuszenecker Róbert</Authors>
    <Owners>Fuszenecker Róbert</Owners>
    <Company>Fuszenecker Software Development</Company>
    <ProjectUrl>https://github.com/fuszenecker/Promptuarium</ProjectUrl>
    <Description>Promptuarium is a versatile, tree-based data structure to store or exchange data and metadata efficiently (in binary format). Written in pure C#, can be used in F#, too.</Description>
    <Copyright>Copyright 2012-2026, Fuszenecker Róbert</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/fuszenecker/Promptuarium</PackageProjectUrl>
    <RepositoryUrl>https://github.com/fuszenecker/Promptuarium</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>promptuarium binary tree serialization space-efficient limitless container</PackageTags>
    <ReleaseNotes>New: ElementBuilder (with signed roots), Element.Insert, the pedit command line tool (attached to the GitHub release). Releases are created automatically from version tags.</ReleaseNotes>
    <PackageReleaseNotes>New: ElementBuilder (with signed roots), Element.Insert, the pedit command line tool (attached to the GitHub release). Releases are created automatically from version tags.</PackageReleaseNotes>
    <PackageIconUrl></PackageIconUrl>
    <NeutralLanguage></NeutralLanguage>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>
