<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <LangVersion>10</LangVersion>
    <Nullable>enable</Nullable>
    <AnalysisLevel>preview</AnalysisLevel>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Promptuarium</PackageId>
    <Title>Promptuarium</Title>
    <Version>6.1.0</Version>
    <Authors>Fuszenecker Róbert</Authors>
    <Owners>Fuszenecker Róbert</Owners>
    <Company>Fuszenecker Software Development</Company>
    <ProjectUrl>https://github.com/fuszenecker/Promptuarium</ProjectUrl>
    <Description>Promptuarium is a versatile, tree-based data structure to store or exchange data and metadata efficiently (in binary format). Written in pure C#, can be used in F#, too.</Description>
    <Copyright>Copyright 2012-2026, Fuszenecker Róbert</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/fuszenecker/Promptuarium</PackageProjectUrl>
    <RepositoryUrl>https://github.com/fuszenecker/Promptuarium</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>promptuarium binary tree serialization space-efficient limitless container</PackageTags>
    <ReleaseNotes>Fixed an encoder bug with nodes having only empty children (the next node was lost). Iterative algorithms for arbitrarily deep trees. Add moves nodes and refuses cycles, the copy constructor creates a deep copy, fixed statistics minimums and VarInt(long.MinValue), files are loaded read-only. Complete binary format specification (BINARY_FORMAT.md).</ReleaseNotes>
    <PackageReleaseNotes>Fixed an encoder bug with nodes having only empty children (the next node was lost). Iterative algorithms for arbitrarily deep trees. Add moves nodes and refuses cycles, the copy constructor creates a deep copy, fixed statistics minimums and VarInt(long.MinValue), files are loaded read-only. Complete binary format specification (BINARY_FORMAT.md).</PackageReleaseNotes>
    <PackageIconUrl></PackageIconUrl>
    <NeutralLanguage></NeutralLanguage>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>
