# Promptuarium container: a signed root whose signature starts with "PRMT" (BINARY_FORMAT.md, 10.3 and 10.4)
1	string	PRMT
>0	byte&0xF0	0x60	Promptuarium container
!:mime	application/x-promptuarium
# The rest of the signature after "PRMT:" (the control byte tells its length)
>>0	byte	0x66
>>>5	string	:
>>>>6	string	x	\b, %.1s
>>0	byte	0x67
>>>5	string	:
>>>>6	string	x	\b, %.2s
>>0	byte	0x68
>>>5	string	:
>>>>6	string	x	\b, %.3s
>>0	byte	0x69
>>>5	string	:
>>>>6	string	x	\b, %.4s
>>0	byte	0x6A
>>>5	string	:
>>>>6	string	x	\b, %.5s
>>0	byte	0x6B
>>>5	string	:
>>>>6	string	x	\b, %.6s
>>0	byte	0x6C
>>>5	string	:
>>>>6	string	x	\b, %.7s
>>0	byte	0x6D
>>>5	string	:
>>>>6	string	x	\b, %.8s
>>0	byte	0x6E
>>>5	string	:
>>>>6	string	x	\b, %.9s
>>0	byte	0x6F
>>>5	string	:
>>>>6	string	x	\b, %.10s
